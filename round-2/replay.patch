+/// Round 2 of the AI leaderboard: replays frozen scripts on a CSV tape through the sandbox dispatcher. `R2_SCRIPTS` JSON list of {runId, script}, `R2_CSV`, `R2_OUT` JSONL.
+#[test]
+#[ignore = "round 2 replay, reads local data"]
+fn round2_replay() {
+    let var = |k: &str| std::env::var(k).unwrap();
+    let scripts: Vec<Value> = serde_json::from_str(&fs::read_to_string(var("R2_SCRIPTS")).unwrap()).unwrap();
+    let g = ctx("round2");
+    let vault = g.vault.clone().unwrap();
+    let d = import(&vault, fs::read_to_string(var("R2_CSV")).unwrap(), "BTC", "4h");
+    let mut rows = String::new();
+    for s in &scripts {
+        let script = s["script"].as_str().unwrap_or("");
+        if script.is_empty() {
+            rows.push_str(&format!("{}\n", json!({"runId":s["runId"],"ran":false,"reason":"no script"})));
+            continue;
+        }
+        let args = json!({"script":script,"datasetId":d,"feeBps":10,"executionSemantics":"tv_exact_v1","includeTrades":true,"verbosity":"full"});
+        let vp = vault.clone();
+        let (prepared, _) = crate::mcp_ergonomics::prepare_call("run_sandbox_backtest", args, crate::mcp_ergonomics::McpProfile::Full, move || Ok(vp)).unwrap();
+        let v = vault.clone();
+        let out = crate::sandbox_mcp::dispatch("run_sandbox_backtest", &prepared, move || Ok(v));
+        let row = match out {
+            Some(o) => {
+                let m = &o["structuredContent"]["backtest"]["metrics"];
+                json!({"runId":s["runId"],"tradeLog":m["trade_log"],"equityFinal":m["equity_final"],"ran":o["isError"] != true,"reason":o["content"][0]["text"].as_str().filter(|_| o["isError"] == true),"pnl_pct":m["pnl_pct"],"max_drawdown_pct":m["max_drawdown_pct"],"trades":m["trades"],"buyHoldPct":m["buyHoldPct"]})
+            }
+            None => json!({"runId":s["runId"],"ran":false,"reason":"no dispatch"}),
+        };
+        rows.push_str(&format!("{row}\n"));
+    }
+    fs::write(var("R2_OUT"), rows).unwrap();
+    let _ = fs::remove_dir_all(&g.store);
+    let _ = fs::remove_dir_all(&vault);
+}
